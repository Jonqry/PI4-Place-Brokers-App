{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://placebrokers-api.onrender.com" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://placebrokers-api.onrender.com", "EXPO_PUBLIC_SITE_URL": "https://placebrokers-frontend.vercel.app" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_API_URL": "https://placebrokers-api.onrender.com", "EXPO_PUBLIC_SITE_URL": "https://placebrokers-frontend.vercel.app" }
    }
  }
}
